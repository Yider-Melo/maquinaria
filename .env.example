# ============================================
# SEGURIDAD - Variables de Entorno Críticas
# ============================================

# Entorno: development, staging, production
NODE_ENV=development
LOG_LEVEL=info

# JWT - OBLIGATORIO en producción (sin valor falla al arrancar)
# Generar con: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# CORS - Orígenes permitidos (separados por comas)
# Desarrollo: http://localhost:4200
# Producción: https://app.rentamaq.com,https://admin.rentamaq.com
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# ============================================
# Base de Datos
# ============================================
DB_USER=postgres
DB_PASSWORD=postgres
POSTGRES_PASSWORD=postgres

# ============================================
# Integración de Servicios
# ============================================
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# Proveedor de pagos: mercadopago | wompi
# wompi - RECOMENDADO para Colombia. Soporta pagos automaticos a propietarios via transferencia bancaria.
# mercadopago - Solo disponible para cobro, no soporta pagos a terceros en Colombia.
PAYMENT_PROVIDER=wompi

# ============================================
# Wompi (Colombia)
# ============================================
# Usar claves de prueba (pub_test_/prv_test_/test_events_) en desarrollo
# y las de producción (pub_prod_/prv_prod_/prod_events_) solo en .env (NO versionar)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENT_SECRET=
WOMPI_INTEGRITY_SECRET=
# Producto 'Pagos a terceros' (dispersión a propietarios). Son llaves DIFERENTES
# a las de cobro. Se obtienen en: dashboard -> Desarrollo -> Programadores ->
# Pagos a Terceros (requiere 2FA). Se envían en headers x-api-key y
# user-principal-id de https://api.payouts.wompi.co/v1
WOMPI_PAYOUTS_API_KEY=
WOMPI_PAYOUTS_USER_PRINCIPAL_ID=
# Cuenta origen para dispersar (Wompi Cuenta). Si va vacío, se descubre
# automáticamente con GET /accounts.
WOMPI_PAYOUTS_ACCOUNT_ID=
# Secret de eventos de Pagos a Terceros. Se obtiene en Programadores ->
# Pagos a Terceros -> Secretos para integración técnica -> Eventos.
WOMPI_PAYOUTS_EVENT_SECRET=

# ============================================
# MercadoPago (alternativa)
# ============================================
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# PAYOUT_MODE solo aplica si PAYMENT_PROVIDER=mercadopago
#   manual - admin paga manualmente (Colombia)
#   simulated - desarrollo
PAYOUT_MODE=manual

# Comisión de la plataforma (porcentaje)
COMISION_PLATAFORMA_PORCENTAJE=10

# ============================================
# Cloudflare R2 - Almacenamiento de imágenes
# ============================================
# Bucket S3-compatible (R2 Object Storage). Si R2_* están vacíos, las imágenes
# se guardan como data URL en la BD (modo demo) en vez de subirse a R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rentamaq-imagenes
R2_PUBLIC_URL=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================
# Autenticación Interna
# ============================================
# Para comunicación entre servicios (OBLIGATORIO en producción)
INTERNAL_API_KEY=

# ============================================
# Rate Limiting
# ============================================
# Número máximo de intentos de login cada 15 minutos
RATE_LIMIT_AUTH_MAX=10

# Número máximo de requests generales por minuto
RATE_LIMIT_GENERAL_MAX=100

# ============================================
# HTTPS (Opcional - certificados SSL)
# ============================================
# Si se proveen estas rutas, el API Gateway inicia con HTTPS
# SSL_CERT_PATH=/certs/cert.pem
# SSL_KEY_PATH=/certs/key.pem

# ============================================
# IMPORTANTE - Producción
# ============================================
# Checklist antes de deployar:
# [ ] NODE_ENV = production
# [ ] JWT_SECRET generado de forma segura (OBLIGATORIO)
# [ ] ALLOWED_ORIGINS = dominios reales
# [ ] INTERNAL_API_KEY configurada (OBLIGATORIO)
# [ ] MERCADOPAGO_WEBHOOK_SECRET configurado (OBLIGATORIO)
# [ ] DB_PASSWORD = contraseña fuerte
# [ ] RABBITMQ_USER / RABBITMQ_PASS no usar defaults
# [ ] LOG_LEVEL = warn o error
# [ ] HTTPS habilitado
# [ ] Certificados SSL válidos
# [ ] Secrets manager configurado
# [ ] Backups habilitados
# [ ] Monitoreo activo
# [ ] Ejecutar: npm run audit
