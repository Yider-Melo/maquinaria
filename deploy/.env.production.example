# ============================================================
# RentaMaq - Variables de producción
# Copia a .env en el servidor y edita los valores reales.
# ============================================================

NODE_ENV=production
LOG_LEVEL=info

# Dominio real (apunta el registro A de GoDaddy a la IP del VPS)
DOMAIN=rentamaqu.online
PUBLIC_URL=https://rentamaqu.online
FRONTEND_URL=https://rentamaqu.online
ALLOWED_ORIGINS=https://rentamaqu.online

# --- SEGURIDAD (genera valores fuertes) ---
# openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=24h
# openssl rand -base64 24
INTERNAL_API_KEY=CAMBIAR_POR_OTRA_CLAVE_ALEATORIA

# --- BASE DE DATOS (cambiar credenciales) ---
DB_USER=rentamaq
DB_PASSWORD=CAMBIAR_CONTRASENA_BD
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_BD

# --- RABBITMQ (cambiar credenciales) ---
RABBITMQ_USER=rentamaq_mq
RABBITMQ_PASS=CAMBIAR_CONTRASENA_RABBIT

# --- PAGOS: proveedor ---
PAYMENT_PROVIDER=wompi

# Wompi - llaves de cobro (producción)
WOMPI_PUBLIC_KEY=pub_prod_TU_LLAVE
WOMPI_PRIVATE_KEY=prv_prod_TU_LLAVE
WOMPI_EVENT_SECRET=prod_events_TU_SECRETO
WOMPI_INTEGRITY_SECRET=prod_integrity_TU_SECRETO

# Wompi - Pagos a terceros (dispersión a propietarios).
# Se obtienen en: dashboard -> Desarrollo -> Programadores -> Pagos a Terceros
WOMPI_PAYOUTS_API_KEY=TU_API_KEY_PAYOUTS
WOMPI_PAYOUTS_USER_PRINCIPAL_ID=TU_ID_USUARIO_PRINCIPAL
# Cuenta origen (Wompi Cuenta). Vacío = se descubre con GET /accounts.
WOMPI_PAYOUTS_ACCOUNT_ID=
# Secret de eventos de Pagos a Terceros (Programadores -> Pagos a Terceros ->
# Secretos para integración técnica -> Eventos).
WOMPI_PAYOUTS_EVENT_SECRET=prod_events_TU_SECRETO_PAYOUTS

# --- MERCADOPAGO (alternativa; comentado) ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# Comisión de la plataforma (%)
COMISION_PLATAFORMA_PORCENTAJE=10

# --- CLOUDFLARE R2 (imágenes) ---
R2_ACCOUNT_ID=TU_ACCOUNT_ID
R2_ACCESS_KEY_ID=TU_ACCESS_KEY
R2_SECRET_ACCESS_KEY=TU_SECRET_KEY
R2_BUCKET=rentamaq-imagenes
R2_PUBLIC_URL=TU_PUBLIC_URL

# --- EMAIL (recuperación de contraseña) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rentamaq18@gmail.com
SMTP_PASS=TU_APP_PASSWORD
SMTP_FROM=rentamaq18@gmail.com

# --- RATE LIMITING ---
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GENERAL_MAX=100
